# Copie este archivo como ".env" para pruebas locales.
# En Render (o el hosting que use), estas mismas variables se configuran en el
# panel "Environment" del servicio — NO se sube el archivo .env a GitHub.

# --- IA ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Datos del despacho (se insertan en las respuestas del asistente) ---
NOMBRE_DESPACHO=Javier Londoño V. Abogados & Asociados
HORARIO_ATENCION=Lunes a viernes, 8:00 a.m. a 5:00 p.m.
ESPECIALIDADES=Derecho de Familia, Derecho Notarial, Derecho Civil (incluye procesos de pertenencia/prescripción) y gestión de Accidentes de Tránsito

# --- WhatsApp Business Cloud API (Meta for Developers) ---
# Token temporal (24h) o permanente que genera Meta al configurar la app de WhatsApp.
WHATSAPP_TOKEN=
# ID del número de teléfono de WhatsApp Business (NO es el número 3178215004 en sí,
# es el "Phone number ID" que muestra el panel de Meta).
WHATSAPP_PHONE_NUMBER_ID=
# Token que usted mismo inventa (una clave larga y aleatoria) y que debe coincidir
# exactamente con el que registre en el campo "Verify Token" del panel de Meta.
WHATSAPP_VERIFY_TOKEN=

# --- Facebook Messenger (Página de Facebook del despacho) ---
FACEBOOK_PAGE_TOKEN=

# --- Envío de formularios PDF ampliados por WhatsApp/Messenger ---
# URL pública base del servicio (para armar el enlace de descarga de cada PDF,
# ej: https://asistente-londono-abogados.onrender.com). En Render, esta variable
# NO hay que configurarla a mano: Render ya provee automáticamente
# RENDER_EXTERNAL_URL con la URL real del servicio. Solo se debe llenar BASE_URL
# a mano si se despliega en otro hosting que no la provea automáticamente.
BASE_URL=

# --- Consulta pagada (formulario de intake -> viabilidad -> oferta de consulta) ---
# Precio que se muestra al cliente (solo texto, no se cobra automáticamente ese valor)
PRECIO_CONSULTA=$150.000 COP
# Enlace de pago reutilizable creado en el panel de Wompi (Comercios -> Links de pago).
# Formato: https://checkout.wompi.co/l/xxxxxx  — ver README_DESPLIEGUE.md, sección Wompi.
WOMPI_LINK_CONSULTA=

# --- Notificaciones por correo cuando llega un cliente nuevo ---
# Reutiliza las credenciales de Gmail del programa de escritorio (contraseña de aplicación).
IMAP_USER=
IMAP_PASS=
# A qué correo se envían las notificaciones (si se deja vacío, se usa IMAP_USER)
NOTIFICAR_A=
# Tamaño máximo (en MB) de un archivo que el cliente envía por el chat para poder
# reenviarlo por correo como adjunto (Gmail rechaza adjuntos más pesados). Opcional,
# por defecto 20.
TAMANO_MAXIMO_ADJUNTO_MB=20
